        },
        {
          "selector": "#fairness table caption >> nth=0",
          "n": 2
        },
        {
          "selector": "#fairness table thead >> nth=0",
          "n": 3
        },
        {
          "selector": "#fairness div.rounded-xl > p >> nth=0",
