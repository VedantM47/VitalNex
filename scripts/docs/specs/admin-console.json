      "path": "/admin/governance",
      "steps": [
        {
          "wait_for": "#overrides dl"
        },
        {
          "scroll_to": "#overrides"
        }
      ],
      "marks": [
        {
          "selector": "#overrides dl >> nth=0",
          "n": 1
        },
        {
          "selector": "#overrides table",
          "n": 2
        },
        {
          "selector": "#overrides h3:has-text('Overrides per reason')",
