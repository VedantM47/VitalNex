          "n": 2
        },
        {
          "selector": "main >> text=Printable report (PDF)",
          "n": 3
        }
      ]
    },
    {
      "name": "reports-pdf",
      "account": "patient1@vitalnex.demo",
      "path": "/reports",
      "width": 1440,
      "height": 900,
      "steps": [
        {
          "wait_for": "text=Download PDF"
