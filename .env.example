# ==============================================================================
# VITALNEX Environment Configuration Template
# ==============================================================================

# Application Mode
NEXT_PUBLIC_DEMO_MODE=true
ENVIRONMENT=development

# Next.js Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Database (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Server-Only (Never expose to client!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Future AI / Agents SDK (Prompt 2 & 3)
OPENAI_API_KEY=your-openai-api-key-placeholder
OPENAI_MODEL=gpt-4o

# Future Realtime / WebRTC (Prompt 3)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Voice / Accessibility Providers (Prompt 3)
VOICE_PROVIDER_API_KEY=your-voice-provider-key
MAPS_PROVIDER_API_KEY=your-maps-provider-key
