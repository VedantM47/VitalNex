# ==============================================================================
# VITALNEX Environment Configuration Template
# ==============================================================================

# One .env at the repo root serves both the API and the web app
# (apps/web/next.config.ts loads it). The API reuses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# as the `apikey` for requests made with a user's JWT, so RLS applies.

# Application Mode
NEXT_PUBLIC_DEMO_MODE=true
ENVIRONMENT=development

# Next.js Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Database (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Server-Only (Never expose to client!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
# Only for projects still on the legacy shared JWT secret (HS256). New projects use
# asymmetric signing keys verified via the public JWKS: leave this empty.
SUPABASE_JWT_SECRET=

# Optional: Supabase personal access token (Account -> Access Tokens).
# Lets the Supabase CLI link the project and push migrations (Phase P1).
# Leave empty to paste the migration SQL into the SQL editor by hand instead.
SUPABASE_ACCESS_TOKEN=

# Shared password for all dummy demo accounts created by the seed script (Phase P1).
# Choose your own; never commit the real value.
DEMO_PASSWORD=

# Where people can report a problem (email or URL), shown in the Trust Passport (Phase P7).
# Leave empty to show "not available". QR share links are built from NEXT_PUBLIC_SITE_URL
# (or PUBLIC_WEB_URL if set).
PROBLEM_REPORT_CONTACT=

# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# NOT USED in the MVP. Nothing in the code reads the variables below.
# Video, voice and external AI providers are frozen (docs/SPEC.md §1.2) and health
# data must never go to a third-party API (CLAUDE.md hard rule 6).
# ------------------------------------------------------------------------------
# Future AI / Agents SDK (Prompt 2 & 3)
OPENAI_API_KEY=your-openai-api-key-placeholder
OPENAI_MODEL=gpt-4o

# Future Realtime / WebRTC (Prompt 3)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Voice / Accessibility Providers (Prompt 3)
VOICE_PROVIDER_API_KEY=your-voice-provider-key
MAPS_PROVIDER_API_KEY=your-maps-provider-key
