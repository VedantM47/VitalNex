{
  "name": "vitalnex",
  "version": "1.1.0",
  "private": true,
  "description": "VITALNEX — AI-Powered Healthcare Intelligence & Connected Care Platform",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "dev:api": "python -m uvicorn apps.api.main:app --reload --port 8000",
    "train:ml": "python -m ml.pipelines.train_pipeline",
    "test:api": "python -m pytest tests -v",
    "test": "npm run test:api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
