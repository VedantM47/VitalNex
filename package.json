{
  "name": "vitalnex",
  "version": "1.1.0",
  "private": true,
  "description": "VITALNEX — AI-Powered Healthcare Intelligence & Connected Care Platform",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "dev:api": "uvicorn apps.api.main:app --reload --port 8000",
    "train:ml": "python -m ml.pipelines.train_pipeline",
    "test:api": "python -m pytest tests -v",
    "test": "npm run test:api"
  }
}
